<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 4.1.1（2026-09 时点 4.1 线最新 GA，java.version 默认 17） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>spring-ai-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-ai-demo</name>
    <description>Spring AI 2.0.1 学习项目</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <!-- 用 BOM 统一管理 spring-ai-* 各模块版本，下面就不用手写 version 了 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          注意：Spring Boot 4 里 spring-boot-starter-web 已被废弃（pom description 原文写着
          "deprecated in favor of spring-boot-starter-webmvc"）。Boot 4 请用下面这个。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!--
          模型接入：DeepSeek 专用 starter。
          它不是"拿 OpenAI 兼容凑合"——Spring AI 为 DeepSeek 单独实现了 DeepSeekChatModel，
          正确处理了 DeepSeek 的接口路径（默认 /chat/completions，没有 /v1），
          并且把 thinking 模式、reasoning-effort、reasoning_content 做成了原生配置项。
          换成走 OpenAI starter 的话，路径得手动改成 /chat/completions，这些参数也没有。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <!--
          想换回 OpenAI / 任意 OpenAI 兼容端点？把上面那个换成下面这个即可。
          注意：ChatController 里的业务代码一行都不用改 —— 这就是 ChatClient 这层抽象的价值。
          <dependency>
              <groupId>org.springframework.ai</groupId>
              <artifactId>spring-ai-starter-model-openai</artifactId>
          </dependency>
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          ===== 多轮对话记忆（第 5 课）=====

          只加这一行，容器里就会多出两个 Bean —— 这是 Spring AI 和 LangChain4j 在
          「装配成本」上最直接的差距（LangChain4j 那边没有任何记忆自动配置，必须手写）。

          这两个 Bean 由 spring-ai-autoconfigure-model-chat-memory:2.0.1 的
          ChatMemoryAutoConfiguration 提供（javap 实证，该类只有两个方法）：
              ChatMemoryRepository chatMemoryRepository()   -> new InMemoryChatMemoryRepository()
              ChatMemory chatMemory(ChatMemoryRepository)   -> MessageWindowChatMemory.builder()
                                                                  .chatMemoryRepository(repo).build()

          注意后者的字节码里**没有调用 .maxMessages(...)** —— 所以窗口大小走的是
          MessageWindowChatMemory 内部的 DEFAULT_MAX_MESSAGES = 20（同样是 javap 从常量池
          里读出来的），而且这个模块里没有 ChatMemoryProperties，也就是说
          **窗口大小在 2.0.1 里没有配置项可以改**。想换尺寸只有一个办法：
          自己声明一个 ChatMemory Bean 把自动配置覆盖掉（MemoryConfig 里有示范）。

          生产上把 InMemory 换成 Redis 也只是换这一行（对应下面的 redis starter）。
          ——你 GRC 里那套 Redis key/序列化/过期策略正好能直接复用。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory</artifactId>
        </dependency>

        <!--
          ===== MCP 客户端（第 6 课）=====

          只加这一行，容器里就会多出两样东西：
              List<McpSyncClient>           —— 连到配置里每个 MCP server 的客户端
              SyncMcpToolCallbackProvider   —— 把它们包装成 Spring AI 认识的 ToolCallbackProvider

          工具的来源从此变了：不再是「进程内的 Java Bean」，而是
          「远端 MCP server 报上来的清单」。tools/list 是运行时查的，
          连你都不必事先知道对面有哪些工具。

          选型注意：本 starter 传递依赖的是 spring-ai-autoconfigure-mcp-client-httpclient，
          走 JDK 自带 HttpClient，**不引入 WebFlux**，所以能和 webmvc 和平共处。
          换成 spring-ai-starter-mcp-client-webflux 则会把整个 Reactive 栈拖进来。

          对照 LangChain4j：那边 MCP 模块（langchain4j-mcp）连 1.20.0 正式版都没跟上
          （只有 1.20.0-beta30），而且**没有对应的 Spring Boot starter**——
          McpClient / McpToolProvider 两个 Bean 必须手写。装配成本差在 MCP 上比在记忆上更明显。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!--
          ===== 下面这些按学习进度逐个打开（都在 spring-ai-bom 2.0.1 里，去掉注释即可）=====

          1) 记忆的持久化实现（BOM 里现成的有 jdbc / redis / cassandra / mongodb / neo4j 五种）
          <dependency>
              <groupId>org.springframework.ai</groupId>
              <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
          </dependency>
          <dependency>
              <groupId>org.springframework.ai</groupId>
              <artifactId>spring-ai-starter-model-chat-memory-repository-redis</artifactId>
          </dependency>

          2) MCP（2026 年最硬的关键词；你的 spec 里 issue 07 就是它）
          <dependency>
              <groupId>org.springframework.ai</groupId>
              <artifactId>spring-ai-starter-mcp-client</artifactId>
          </dependency>

          3) 向量库（对应你 RAG 计划里的 pgvector 选型）
          <dependency>
              <groupId>org.springframework.ai</groupId>
              <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
          </dependency>

          4) 本地模型（想不花钱、不联网跑通全流程时用）
          <dependency>
              <groupId>org.springframework.ai</groupId>
              <artifactId>spring-ai-starter-model-ollama</artifactId>
          </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

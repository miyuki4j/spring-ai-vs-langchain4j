<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      为什么这里是 3.5.16？

      LangChain4j 为 Spring Boot 3 和 4 提供了**两套并行**的 starter，命名规则是：
        langchain4j-{integration}-spring-boot-starter    -> Spring Boot 3
        langchain4j-{integration}-spring-boot4-starter   -> Spring Boot 4

      两套都确认发布在 1.20.0-beta30。但它们各自编译时钉死的 Spring Boot 版本不同：
        ...-spring-boot-starter  (Boot 3) -> spring-boot-starter:3.5.13
        ...-spring-boot4-starter (Boot 4) -> spring-boot-starter:4.0.5

      这里选 Boot 3 线（3.5.16 是 3.5 最新 GA），因为 starter 的编译目标是 3.5.13，
      3.5.16 与它同一补丁线，风险最低。

      想换 Boot 4：把 parent version 改成 4.1.1，并把下面两个依赖换成 boot4 版本：
        langchain4j-spring-boot-starter        -> langchain4j-spring-boot4-starter
        langchain4j-open-ai-spring-boot-starter -> langchain4j-open-ai-spring-boot4-starter
      注意那套 boot4 starter 目前针对 4.0.5 编译，还没跟到 4.1.x，属于"能试但没保证"。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>langchain4j-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>langchain4j-demo</name>
    <description>LangChain4j 1.20.0 学习项目</description>

    <properties>
        <java.version>17</java.version>
        <!-- 核心模块 1.20.0；starter 类模块由 BOM 解析到 1.20.0-beta30 -->
        <langchain4j.version>1.20.0</langchain4j.version>
        <!--
          MCP 模块必须单独钉版本，原因值得记一笔：
          langchain4j-mcp **没有** 1.20.0 正式版（Maven Central 上是 404），
          它只发到 1.20.0-beta30。所以哪怕 BOM 升到了 1.20.0，
          这个模块也得写明 beta30，否则解析不到。
          这正是「一个子模块没跟上主线节奏」的典型后果。
        -->
        <langchain4j-mcp.version>1.20.0-beta30</langchain4j-mcp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 提供 @AiService 声明式接口（LangChain4j 最有辨识度的用法） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
        </dependency>

        <!--
          模型接入：OpenAI starter。
          LangChain4j 没有 DeepSeek 专用模块（没有 langchain4j-deepseek，
          也没有对应的 community 模块或 starter —— 都试过，Maven Central 上是 404）。
          所以 DeepSeek 走 OpenAI 兼容，靠 application.yml 改 base-url。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
        </dependency>

        <!--
          ===== MCP 客户端（第 6 课）=====

          只有这一个模块，而且**没有 Spring Boot starter** ——
          dev.langchain4j 下与 MCP 相关的 artifact 一共就四个
          （langchain4j-mcp / langchain4j-community-mcp-server / langchain4j-agentic-mcp / langchain4j-mcp-docker），
          全都不是 starter。所以客户端那三个对象（Transport / McpClient / McpToolProvider）
          必须自己 new 出来，见 config/McpClientConfig.java。

          对照 Spring AI：那边一个 spring-ai-starter-mcp-client 就把
          McpSyncClient 列表和 SyncMcpToolCallbackProvider 全自动配好了。
          这是两个框架在「装配成本」上的第三次同题对照
          （第一次是记忆、第二次是模型，这次是 MCP），结论一致：
          **Spring AI 走 Spring Boot 原生自动配置，LangChain4j 更偏「库」的形态。**
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
            <version>${langchain4j-mcp.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
